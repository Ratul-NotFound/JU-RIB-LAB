// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Auth (NextAuth v5) ──────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Users / Members ────────────────────────────────────────────────

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(STUDENT)
  isActive      Boolean   @default(true)
  accounts      Account[]
  sessions      Session[]
  profile       Profile?
  posts         Post[]
  publications  Publication[]
  createdProjects Project[]  @relation("ProjectCreator")
  createdActivities Activity[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Profile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug           String   @unique
  fullName       String
  designation    String?
  department     String?
  bio            String?  @db.Text
  avatarUrl      String?
  phone          String?
  linkedin       String?
  googleScholar  String?
  researchGate   String?
  orcid          String?
  website        String?
  joiningDate    DateTime?
  isActive       Boolean  @default(true)
  projectMembers ProjectMember[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ─── Projects ───────────────────────────────────────────────────────

enum ProjectStatus {
  ONGOING
  COMPLETED
  UPCOMING
  PAUSED
}

model Project {
  id           String        @id @default(cuid())
  slug         String        @unique
  title        String
  description  String        @db.Text
  content      String?       @db.Text
  thumbnailUrl String?
  status       ProjectStatus @default(ONGOING)
  category     String?
  tags         String[]
  isFeatured   Boolean       @default(false)
  startDate    DateTime?
  endDate      DateTime?
  fundingSource String?
  createdBy    String
  creator      User          @relation("ProjectCreator", fields: [createdBy], references: [id])
  members      ProjectMember[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model ProjectMember {
  id        String  @id @default(cuid())
  projectId String
  profileId String
  role      String  @default("Member")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([projectId, profileId])
}

// ─── Publications ────────────────────────────────────────────────────

enum PublicationType {
  JOURNAL
  CONFERENCE
  BOOK_CHAPTER
  PATENT
  THESIS
  OTHER
}

model Publication {
  id            String          @id @default(cuid())
  title         String
  authors       String
  journal       String?
  year          Int
  doi           String?
  abstract      String?         @db.Text
  pdfUrl        String?
  type          PublicationType @default(JOURNAL)
  citationCount Int?
  isFeatured    Boolean         @default(false)
  createdBy     String
  creator       User            @relation(fields: [createdBy], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

// ─── Activities / Events ─────────────────────────────────────────────

enum ActivityType {
  SEMINAR
  WORKSHOP
  CONFERENCE
  FIELDWORK
  TRAINING
  OTHER
}

model Activity {
  id           String       @id @default(cuid())
  slug         String       @unique
  title        String
  description  String       @db.Text
  content      String?      @db.Text
  thumbnailUrl String?
  eventDate    DateTime
  endDate      DateTime?
  location     String?
  type         ActivityType @default(OTHER)
  isFeatured   Boolean      @default(false)
  createdBy    String
  creator      User         @relation(fields: [createdBy], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// ─── Blog Posts ───────────────────────────────────────────────────────

enum PostStatus {
  DRAFT
  PUBLISHED
}

model Post {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  excerpt     String?    @db.Text
  content     String     @db.Text
  coverUrl    String?
  tags        String[]
  status      PostStatus @default(DRAFT)
  authorId    String
  author      User       @relation(fields: [authorId], references: [id])
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// ─── Lab Settings (Singleton) ─────────────────────────────────────────

model LabSettings {
  id          String  @id @default("singleton")
  labName     String  @default("Bioresources Technology and Industrial Biotechnology Laboratory")
  university  String  @default("Jahangirnagar University")
  tagline     String?
  about       String? @db.Text
  vision      String? @db.Text
  mission     String? @db.Text
  address     String?
  email       String?
  phone       String?
  foundedYear Int?
  logoUrl     String?
  heroImageUrl String?
  facebookUrl  String?
  twitterUrl   String?
  linkedinUrl  String?
  youtubeUrl   String?
  updatedAt   DateTime @updatedAt
}
